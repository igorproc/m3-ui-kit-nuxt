        },
        "pressed": {
          "color": "color-mix(in srgb, var(--md-sys-color-on-primary) 12%, var(--md-sys-color-primary))"
        },
        "disabled": {
          "color": "color-mix(in srgb, var(--md-sys-color-on-surface) 12%, transparent)"
        }
      },
      "label": {
