{
  "name": "@pr0s1k/primetime-kit",
  "version": "0.3.0",
  "type": "module",
  "description": "PrimeTime UI Kit — a Nuxt 4 layer & Material Design 3 component library (zero-runtime SCSS tokens).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorproc/m3-ui-kit-nuxt.git"
  },
  "main": "./dist/module.mjs",
  "types": "./dist/module.d.mts",
  "author": {
    "email": "type19790098@gmail.com",
    "name": "Igor Prosvirnin"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./defineKit": {
      "types": "./dist/runtime/shared/utils/setup/defineKit.d.ts",
      "import": "./dist/runtime/shared/utils/setup/defineKit.js"
    },
    "./types": {
      "types": "./dist/runtime/shared/types/props.d.ts",
      "import": "./dist/runtime/shared/types/props.js"
    },
    "./validation": {
      "types": "./dist/runtime/adapters/vee-validate/index.d.ts",
      "import": "./dist/runtime/adapters/vee-validate/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "!app/**/*.spec.ts",
    "!src/**/*.spec.ts",
    "!src/**/specs"
  ],
  "sideEffects": [
    "**/*.scss",
    "**/*.css",
    "**/*.vue"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "build:module": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test": "vitest",
    "lint": "eslint .",
    "lint:style": "stylelint **/*.{vue,css,scss}"
  },
  "dependencies": {
    "@iconify-json/ic": "^1.2.4",
    "@material/material-color-utilities": "^0.4.0",
    "@nuxt/icon": "^2.2.1",
    "@nuxtjs/device": "^4.0.0",
    "@pinia/nuxt": "^0.11.3",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "dayjs": "^1.11.20",
    "pinia": "^3.0.4",
    "vue-final-modal": "^4.5.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxtjs/stylelint-module": "^5.2.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.3.0",
    "happy-dom": "^20.9.0",
    "nuxt": "4.4.8",
    "sass": "^1.99.0",
    "stylelint": "^17.9.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-scss": "^7.0.0",
    "vee-validate": "^4.15.1",
    "vitest": "^4.1.5",
    "vue-router": "^5.0.6",
    "yup": "^1.7.1"
  },
  "peerDependencies": {
    "nuxt": "^4.4.8",
    "vue": "3.5.39",
    "vee-validate": "^4.15.0",
    "yup": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "vee-validate": {
      "optional": true
    },
    "yup": {
      "optional": true
    }
  }
}
